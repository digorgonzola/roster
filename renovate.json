{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":pinAllExceptPeerDependencies",
    "schedule:weekly"
  ],
  "timezone": "Australia/Hobart",
  "platformAutomerge": false,
  "automergeStrategy": "squash",
  "labels": ["dependencies"],
  "minimumReleaseAge": "14 days",
  "internalChecksFilter": "strict",
  "semanticCommits": "enabled",
  "semanticCommitType": "build",
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on the first day of the month"]
  },
  "postUpdateOptions": ["pnpmDedupe"],
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"]
  },
  "packageRules": [
    {
      "description": "Leave pnpm-workspace override ranges alone. They are hand-written security floors; pinning one rewrites the range to the latest major (see PR #26, which pinned the nanoid override to 6.0.1)",
      "matchDepTypes": ["pnpm-workspace.overrides"],
      "enabled": false
    },
    {
      "description": "GitHub Actions updates use the ci: commit type, matching repo convention",
      "matchManagers": ["github-actions"],
      "semanticCommitType": "ci"
    },
    {
      "description": "Group React runtime and type packages into one PR",
      "groupName": "react",
      "matchPackageNames": [
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom"
      ]
    },
    {
      "description": "Group Vite, Vitest, and related plugins into one PR to keep the ecosystem in lockstep",
      "groupName": "vite",
      "matchPackageNames": [
        "vite",
        "vitest",
        "/^@vitejs//",
        "/^@vitest//",
        "/^vite-/"
      ]
    },
    {
      "description": "Major updates wait for approval on the Dependency Dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Automerge devDependency patch/minor updates once the required-checks gate passes",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Automerge GitHub Actions digest and patch/minor updates",
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "automerge": true
    }
  ]
}
