{
  "name": "roster",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Household chore roster — add people & chores, weekly + one-off scheduling, grayscale-safe A4 printout.",
  "packageManager": "pnpm@12.5.1+sha512.e3f305bc784a2bc89f5ad3b6138889470fae8d2af5f36b61216ec91c2c3d64089775f9de38aac331044ea40f245cb0d5666392dfdf65824e1907ef6a2c62de5f",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && tsc -p worker && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "lucide-react": "1.28.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260801.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.137.0"
  }
}
