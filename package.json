{
  "name": "roster",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Household chore roster — add people & chores, weekly + one-off scheduling, grayscale-safe A4 printout.",
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && tsc -p worker && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "lucide-react": "1.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261025.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "4.1.12",
    "wrangler": "4.152.0"
  }
}
