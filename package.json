{
  "name": "roster",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Household chore roster — add people & chores, weekly + one-off scheduling, grayscale-safe A4 printout.",
  "packageManager": "pnpm@12.12.1+sha512.b7f98934c0b1f29a65f5da52f2d7f994e7faad573ffdddea1497fb4dcb5aec051590ee7c7d95a38172b4bfae103a5b83edf2ee866e11731c2cafa96063610ac5",
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "dev:worker": "wrangler dev",
    "build": "tsc -b && tsc -p worker && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "lucide-react": "1.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261011.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.4",
    "vitest": "4.1.11",
    "wrangler": "4.149.0"
  }
}
