#!/bin/sh
set -e

echo "pre-commit: typecheck"
pnpm exec tsc -b

# Audit GitHub Actions workflows when any are staged. Offline + regular
# persona to match CI's gate; the zizmor.yml workflow runs the full online
# pass on the PR. Skips (CI still enforces) if no zizmor runner is installed.
WORKFLOW_CHANGES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^\.github/(workflows|actions)/' || true)
if [ -n "$WORKFLOW_CHANGES" ]; then
  echo "pre-commit: zizmor (workflow security)"
  if command -v zizmor >/dev/null 2>&1; then
    zizmor --persona regular --offline .github/workflows/
  elif command -v uvx >/dev/null 2>&1; then
    uvx zizmor@1.27.0 --persona regular --offline .github/workflows/
  else
    echo "  ⚠ zizmor not found (install: uv tool install zizmor) — skipping; CI will enforce"
  fi
fi
