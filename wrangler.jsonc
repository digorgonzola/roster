{
  "name": "roster",
  "main": "worker/index.ts",
  // Newest date the local workerd binary (wrangler 4.118.0) supports.
  "compatibility_date": "2026-08-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API must never fall through to static assets.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RosterRoom" }]
  },
  "migrations": [
    // SQLite-backed classes: required for Durable Objects on the free plan.
    { "tag": "v1", "new_sqlite_classes": ["RosterRoom"] }
  ],
  "env": {
    // Branch previews. Version uploads cannot apply Durable Object
    // migrations (Cloudflare error 10211), so non-production branches must
    // run a full deploy against a separate Worker instead:
    //   npx wrangler deploy --env preview
    // This deploys `roster-preview` with its own isolated Durable Objects.
    // Set that as the non-production deploy command in the Workers Builds
    // settings. `assets` and `main` are inherited; DO bindings are not.
    "preview": {
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RosterRoom" }]
      }
    }
  }
}
