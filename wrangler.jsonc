{
  "name": "roster",
  "main": "worker/index.ts",
  // Newest date the local workerd binary (wrangler 4.118.0) supports.
  "compatibility_date": "2026-08-06",
  // Production is reachable only on the custom domain, which Access guards.
  // A workers.dev or version preview URL would serve the app outside Access.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "roster.crunchyapple.xyz", "custom_domain": true }],
  // HOUSEHOLD_EMAILS is an optional secret (`wrangler secret put`): people
  // who join the default household at first sign-in. The Worker answers every
  // API request with 500 until the Access vars are valid (docs/setup.md).
  "vars": {
    "ENVIRONMENT": "production",
    "ACCESS_TEAM_DOMAIN": "https://crunchyapple.cloudflareaccess.com",
    "ACCESS_AUD": "ee1e0fad6f9830754aae4d65f0f42e9a76f6b96adbe51faa896937bd179cd308"
  },
  // Households, memberships and invites. Migrations run before each deploy
  // (.github/workflows/deploy.yml) and stay additive: the old Worker serves
  // until the deploy finishes.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "roster",
      "database_id": "c64c13e5-5211-49a9-b52f-0b3aa1ca09f6",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // The API must never fall through to static assets.
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "RosterRoom" }]
  },
  "migrations": [
    // SQLite-backed classes: required for Durable Objects on the free plan.
    // Production deploys run `wrangler deploy` from GitHub Actions, which
    // applies a new DO migration. Never connect Workers Builds: its branch
    // builds cannot apply DO migrations and would bind production D1.
    { "tag": "v1", "new_sqlite_classes": ["RosterRoom"] }
  ],
  "env": {
    // PR preview deployments (deployed from GitHub Actions, see
    // .github/workflows/deploy-preview.yml). A separate Worker
    // ("roster-preview") with its own D1 database and DO namespace, so
    // preview data is isolated from production.
    //
    // Bindings, vars and migrations are NON-inheritable per-environment keys
    // in wrangler config, so they are repeated here. Keep them in lockstep
    // with the top-level config.
    "preview": {
      "name": "roster-preview",
      // Previews live on workers.dev, protected by one-click Access
      // (docs/setup.md). Version preview URLs stay off: they bypass that.
      "workers_dev": true,
      "preview_urls": false,
      // routes is inheritable: without this, a preview deploy would move the
      // production custom domain onto the preview Worker.
      "routes": [],
      "vars": {
        "ENVIRONMENT": "preview",
        "ACCESS_TEAM_DOMAIN": "https://crunchyapple.cloudflareaccess.com",
        "ACCESS_AUD": "ee1e0fad6f9830754aae4d65f0f42e9a76f6b96adbe51faa896937bd179cd308"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "roster-preview",
          "database_id": "c8a6c81d-0165-451e-8f13-093975cffa9f",
          "migrations_dir": "migrations"
        }
      ],
      "durable_objects": {
        "bindings": [{ "name": "ROOMS", "class_name": "RosterRoom" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RosterRoom"] }]
    }
  },
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true
    }
  }
}
